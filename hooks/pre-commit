#!/bin/sh
#
# Pre-commit hook for Cloud Stack Generator
# Runs tests and ensures code quality before allowing commits
#

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    printf "${GREEN}[PRE-COMMIT]${NC} $1\n"
}

print_error() {
    printf "${RED}[ERROR]${NC} $1\n"
}

print_warning() {
    printf "${YELLOW}[WARNING]${NC} $1\n"
}

# Check if we're in a Python environment
if ! command -v python &> /dev/null; then
    print_error "Python is not available. Please ensure Python is installed."
    exit 1
fi

# Check if pytest is available
if ! python -c "import pytest" &> /dev/null; then
    print_error "pytest is not available. Please install dependencies with: pip install -r requirements.txt"
    exit 1
fi

# Step 1: Run cloud infrastructure unit tests only (fast)
print_status "Running cloud infrastructure unit tests..."
if ! python -m pytest tests/unit/test_aws_credentials.py tests/unit/test_s3_manager.py tests/unit/test_oac_methods.py tests/unit/test_api_key_manager_aws.py tests/unit/test_gcs_provider.py -v --tb=short -x; then
    print_error "Cloud infrastructure unit tests failed. Please fix failing tests before committing."
    exit 1
fi

# Step 2: Check test coverage for cloud infrastructure (AWS + Multi-Cloud Providers)
print_status "Checking test coverage for cloud infrastructure..."
COVERAGE_OUTPUT=$(python -m pytest tests/unit/test_aws_credentials.py tests/unit/test_s3_manager.py tests/unit/test_oac_methods.py tests/unit/test_gcs_provider.py --cov=src.core.aws --cov=src.core.deployment.providers --cov-report=term-missing --cov-fail-under=69 -q)
COVERAGE_EXIT_CODE=$?

if [ $COVERAGE_EXIT_CODE -ne 0 ]; then
    print_error "Cloud infrastructure test coverage is below 69%. Please add more tests."
    echo "$COVERAGE_OUTPUT"
    exit 1
fi

# Step 3: Run static analysis (if available)
if command -v ruff &> /dev/null; then
    print_status "Running ruff linting..."
    if ! ruff check src/ --quiet; then
        print_warning "Ruff linting issues found. Please review and fix."
        # Don't exit on linting issues - just warn
    fi
fi

# Step 4: Check for common issues
print_status "Checking for common issues..."

# Check for TODO comments in new commits
if git diff --cached --name-only | xargs grep -l "TODO" 2>/dev/null; then
    print_warning "TODO comments found in staged files. Consider addressing before committing."
fi

# Check for debugging statements
if git diff --cached --name-only | grep "\.py$" | xargs grep -l -E "(print\(|pdb\.set_trace|breakpoint\()" 2>/dev/null; then
    print_warning "Debug statements (print, pdb, breakpoint) found in staged Python files."
fi

# Check for hardcoded secrets - exclude test files
if git diff --cached --name-only | grep -v "test_" | xargs grep -l -E "(password|secret|api_key|access_key).*=.*['\"][A-Za-z0-9+/]{10,}['\"]" 2>/dev/null; then
    print_error "Potential hardcoded secrets found. Please use secure configuration."
    exit 1
fi

print_status "All pre-commit checks passed! ✓"
print_status "Commit will proceed..."

exit 0