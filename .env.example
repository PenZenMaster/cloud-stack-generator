# Environment Configuration for Cloud Stack Generator
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS

# =============================================================================
# GitHub Integration
# =============================================================================
# GitHub Personal Access Token for repository operations
# Get token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# =============================================================================
# OpenAI API Configuration
# =============================================================================
# OpenAI API Key for AI-powered content generation
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to disable AI features (falls back to template-based generation)
OPENAI_API_KEY=

# OpenAI Model Settings (optional - uses these defaults if not specified)
# Recommended: gpt-4o-mini (cost-efficient, ~$0.0007 per page)
# Alternative: gpt-4o, gpt-4-turbo (higher quality, higher cost)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# AI Content Generation Features
# Set to 'false' to disable AI and use only template-based generation
AI_CONTENT_ENABLED=true

# Enable caching to reduce API costs (highly recommended)
AI_CONTENT_CACHE_ENABLED=true

# Cache duration in hours (168 = 7 days)
# Cached content is reused during this period, saving API costs
AI_CONTENT_CACHE_HOURS=168